# Port the local monitor server listens on. Must match CCM_PORT used by hooks.
CCM_PORT=4756

# Optional: Telegram notifications (skip these two lines to only get desktop notifs)
# 1. Chat with @BotFather on Telegram, /newbot, copy the token below.
# 2. Message your new bot once, then visit:
#    https://api.telegram.org/bot<token>/getUpdates
#    to find your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ringkasan task selesai ------------------------------------------------
# 0 = notif Stop kembali jadi teks generik tanpa ringkasan.
CCM_STOP_SUMMARY=1
# Panjang maksimal ringkasan (karakter) sebelum dipotong.
CCM_SUMMARY_MAX_CHARS=180

# --- Remote approval (opt-in) ---------------------------------------------
# SECURITY: dengan ini menyala, siapa pun yang bisa mengirim pesan ke bot kamu
# bisa menyetujui eksekusi tool di mesin ini. Bot token = kunci mesin. Jangan
# nyalakan di komputer bersama, dan jangan pernah commit token-nya.
# 1 = izin tool (PreToolUse) ditanyakan lewat Telegram/dashboard.
CCM_REMOTE_APPROVAL=0
# Tool apa saja yang boleh diminta izinnya dari jauh. "*" = semua (tidak disarankan).
CCM_ASK_TOOLS=Bash,Write,Edit,MultiEdit,NotebookEdit
# 1 = pertanyaan Claude (hook Stop) diteruskan, jawabanmu dikirim balik ke agent.
# Kosong = ikut CCM_REMOTE_APPROVAL.
CCM_REMOTE_QUESTIONS=
# Batas berapa kali balas-balasan pertanyaan per sesi sebelum berhenti sendiri.
CCM_ASK_MAX_ROUNDS=20

# --- Meta Ads ---------------------------------------------------------------
# Report tiap slot jam WIB + cek mendesak tiap jam. Token & akun dibaca dari
# env User Windows (META_ACCESS_TOKEN, META_ACCOUNT_ID), bukan dari file ini.
# 0 = pemantau mati.
META_ADS_MONITOR=1
# Tahap yang sedang jalan. Ganti saat pindah tahap, lalu restart server.
META_PHASE_NAME=Tahap 1
META_PHASE_START=2026-10-16
META_PHASE_END=2026-10-22
META_PHASE_BUDGET=1000000
# Aturan keputusan: biaya per Lead di atas KILL matikan, di bawah WIN pemenang,
# dinilai sesudah ad set habis MIN_SPEND dan jalan minimal 2 hari.
META_KILL_CPL=4000
META_WIN_CPL=1500
META_MIN_SPEND=50000
META_REPORT_HOURS=7,10,13,16,19,22
# Angka situs dan penjualan iPaymu dari app CareerPlan. Token = statsToken app.
# Kosong = bagian situs dan penjualan dilewati.
HAPPI_STATS_URL=https://www.happicareerplan.com/api/stats?days=7
HAPPI_SALES_URL=https://www.happicareerplan.com/api/admin/sales
HAPPI_STATS_TOKEN=
