# Port the local monitor server listens on. Must match CCM_PORT used by hooks.
CCM_PORT=4756

# Optional: Telegram notifications (skip these two lines to only get desktop notifs)
# 1. Chat with @BotFather on Telegram, /newbot, copy the token below.
# 2. Message your new bot once, then visit:
#    https://api.telegram.org/bot<token>/getUpdates
#    to find your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
